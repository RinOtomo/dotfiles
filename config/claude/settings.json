{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*key*)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(**/secrets/**)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "language": "Japanese",
  "effortLevel": "xhigh",
  "showThinkingSummaries": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
